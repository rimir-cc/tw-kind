\procedure kind.apply-defaults-to(type-tid, target-tid)
<!-- Walks the type's fields. For each field, fires one $action-setfield whose
     $value is computed AT FIRE TIME via three-tier filter:
       1. existing non-blank value → keep (idempotent for user-typed values)
       2. else `kind.compute-default` (subfilter against draft) if non-blank
       3. else existing value (typically empty)
     The gate-inside-$value is critical for re-firing: when called from a
     ref/enum trailer in the same action chain that just set the dependency,
     the previous gating shape `<$list filter="…compute-default…!is[blank]">`
     evaluated at render time (before the dependency was set), so dependent
     fields' setfields were never rendered into the action tree at all.
     Putting the gate in `$value={{{…}}}` defers evaluation to fire time so
     each setfield sees the just-updated dependency state.
     `default` is always a subfilter evaluated against the draft, so
     `[[planned]]` writes the literal "planned", `[<now "YYYY0MM0DD0hh0mm0ss0XXX">]`
     writes the current timestamp, `[get[parent]get[caption]]` reads from the
     draft's parent. Also stamps `kind.type` so the draft is recognised by
     downstream consumers (e.g. the side-preview's instance-view template). -->
<$action-setfield $tiddler=<<target-tid>> kind.type={{{ [<type-tid>get[kind.type]] }}}/>
<$list filter="[function[kind.field-keys],<type-tid>]" variable="field-key">
<$list filter="[function[kind.field-default],<type-tid>,<field-key>!is[blank]] +[first[]]" variable="_">
<$action-setfield $tiddler=<<target-tid>> $field=<<field-key>> $value={{{ [<target-tid>get<field-key>!is[blank]] ~[function[kind.compute-default],<type-tid>,<field-key>,<target-tid>!is[blank]] ~[<target-tid>get<field-key>] +[first[]] }}}/>
</$list>
</$list>
\end

\procedure kind.gm-edit(entity-tid)
<!-- Open the shared graph-modal ($:/plugins/rimir/kind/graph-modal, tagged
     $:/tags/AboveStory) in EDIT mode for an existing instance. Single source for
     "edit this entity", used by the Instances Overview graph tooltip AND the
     rimir/dashboard entity actions, so both drive the same modal identically. -->
<$action-deletetiddler $tiddler="$:/state/rimir/kind/graph-modal"/>
<$action-setfield $tiddler="$:/state/rimir/kind/graph-modal" edit=<<entity-tid>>/>
\end

\procedure kind.gm-delete(entity-tid)
<!-- Open the shared graph-modal in DELETE-confirm mode; the modal re-checks for
     parent-field children before allowing the delete. -->
<$action-deletetiddler $tiddler="$:/state/rimir/kind/graph-modal"/>
<$action-setfield $tiddler="$:/state/rimir/kind/graph-modal" delete=<<entity-tid>>/>
\end

\procedure kind.gm-create(type-tid, host-tid, after-create)
<!-- Open the shared graph-modal in CREATE mode: seed the draft at
     $:/state/rimir/kind/graph-modal/draft with the kind's field defaults
     applied (and parent = host when a host is given), then point the modal at
     the kind. The modal reuses the standard editor + kind.finalize-create
     (title-formula, validation, auto-children all behave exactly like the
     Creator). Without a host it is a plain "new instance" (page toolbar
     create-button, which passes after-create="kind.gm-link-created" so the
     new instance opens). -->
<$action-deletetiddler $tiddler="$:/state/rimir/kind/graph-modal"/>
<$action-deletetiddler $tiddler="$:/state/rimir/kind/graph-modal/draft"/>
<%if [<host-tid>!is[blank]] %>
<$action-setfield $tiddler="$:/state/rimir/kind/graph-modal/draft" parent=<<host-tid>>/>
<%endif%>
<$transclude $variable="kind.apply-defaults-to" type-tid=<<type-tid>> target-tid="$:/state/rimir/kind/graph-modal/draft"/>
<$action-setfield $tiddler="$:/state/rimir/kind/graph-modal" kind-tid=<<type-tid>> host=<<host-tid>> after-create=<<after-create>>/>
\end

\procedure kind.gm-add-child(child-type-tid, host-tid)
<!-- CREATE-CHILD mode of the graph-modal: a new <<child-type-tid>> instance
     with parent = host (graph tooltip, dashboard entity actions). -->
<$transclude $variable="kind.gm-create" type-tid=<<child-type-tid>> host-tid=<<host-tid>>/>
\end

\procedure kind.gm-create-linked(type-tid, host-tid, field-key, dir, copy)
<!-- Open the shared graph-modal in CREATE mode for a new <<type-tid>> instance
     linked to <<host-tid>>:
       dir=in  — the new instance points at the host through ITS field
                 <<field-key>> (seeded into the draft, visible in the form)
       dir=out — the host's field <<field-key>> gets the new instance
                 (kind.gm-link-created after save); if that field has an
                 `inverse` the new kind defines, the draft is seeded with it.
     copy=yes (kind.spawns) also prefills the draft from the host: every field
     of the new kind that the host has, except the link field, computed fields
     and fields with their own `default` (kind.spawn-copy-keys); ref values the
     field does not accept are dropped, groups become their members
     (kind.spawn-ref-string). Defaults then fill what is still blank.
     Inverse sync (inverse.js) mirrors the other end of any inverse pair once
     the instance is saved; drafts under $:/state/ are not instances, so the
     seeded link does not leak onto the host while the form is open. -->
<$let draft="$:/state/rimir/kind/graph-modal/draft">
<$action-deletetiddler $tiddler="$:/state/rimir/kind/graph-modal"/>
<$action-deletetiddler $tiddler=<<draft>>/>
<%if [<dir>match[in]] %>
<$action-setfield $tiddler=<<draft>> $field=<<field-key>> $value={{{ [function[kind.link-value],<type-tid>,<field-key>,<host-tid>] }}}/>
<%else%>
<$list filter="[<host-tid>get[kind.type]] :map[function[kind.locate-type],<currentTiddler>] :map[function[kind.field-inverse],<currentTiddler>,<field-key>] :filter[function[kind.is-ref-typed],<type-tid>,<currentTiddler>]" variable="inv-key">
<$action-setfield $tiddler=<<draft>> $field=<<inv-key>> $value={{{ [function[kind.link-value],<type-tid>,<inv-key>,<host-tid>] }}}/>
</$list>
<%endif%>
<%if [<copy>match[yes]] %>
<$list filter="[function[kind.spawn-copy-keys],<type-tid>,<host-tid>,<field-key>]" variable="ck">
<%if [function[kind.is-ref-typed],<type-tid>,<ck>] %>
<$action-setfield $tiddler=<<draft>> $field=<<ck>> $value={{{ [function[kind.spawn-ref-string],<type-tid>,<ck>,<host-tid>] }}}/>
<%else%>
<$action-setfield $tiddler=<<draft>> $field=<<ck>> $value={{{ [<host-tid>get<ck>] }}}/>
<%endif%>
</$list>
<%endif%>
<$transclude $variable="kind.apply-defaults-to" type-tid=<<type-tid>> target-tid=<<draft>>/>
<$action-setfield $tiddler="$:/state/rimir/kind/graph-modal" kind-tid=<<type-tid>> host=<<host-tid>> link-field=<<field-key>> link-dir=<<dir>> after-create="kind.gm-link-created"/>
</$let>
\end

\procedure kind.gm-link-created()
<!-- after-create hook of kind.gm-create-linked and the page toolbar
     create-button (runs inside finalize-create, so <<createTiddler-title>> is
     the saved title): for dir=out add the new instance to the host's field,
     then open the new instance. -->
<$let
  gm="$:/state/rimir/kind/graph-modal"
  new-tid=<<createTiddler-title>>
>
<$let
  link-host={{{ [<gm>get[host]] }}}
  link-field={{{ [<gm>get[link-field]] }}}
>
<%if [<gm>get[link-dir]match[out]] %>
<$let link-type={{{ [<link-host>get[kind.type]] :map[function[kind.locate-type],<currentTiddler>] }}}>
<%if [function[kind.field-cardinality],<link-type>,<link-field>match[multi]] %>
<$action-setfield $tiddler=<<link-host>> $field=<<link-field>> $value={{{ [<link-host>get<link-field>enlist-input[]] [<new-tid>] +[format:titlelist[]join[ ]] }}}/>
<%else%>
<$action-setfield $tiddler=<<link-host>> $field=<<link-field>> $value=<<new-tid>>/>
<%endif%>
</$let>
<%endif%>
<$action-navigate $to=<<new-tid>>/>
</$let>
</$let>
\end

\procedure kind.finalize-create(kind-tid, kind-type-key, draft-tid, savetitle, after-create)
<!-- Shared "create the new instance" tail used by every save path (creator,
     cascade-save-instance, cascade-spawn-save, cascade-create-here). Computes
     the title via the kind's title-formula, creates the tiddler from the draft
     template, captures the post-uniquification title in <<savetitle>>, and
     runs apply-auto-children against that title. Callers pass their own
     savetitle so the captured title remains visible to flow-specific follow-ups
     (e.g. mass-create's $action-navigate). Idempotent in the sense that the
     auto-children step is a no-op for kinds without kind.auto-children.

     apply-auto-children MUST be nested INSIDE the createtiddler (not a
     sibling): $action-createtiddler exposes the real post-uniquification title
     only to its CHILDREN — via the <<createTiddler-title>> variable + a
     refreshChildren() call (core action-createtiddler.js) — both fired before
     the child action chain runs. A sibling read of {{{[<savetitle>get[text]]}}}
     is evaluated at render time (the change event is async), so it sees a stale
     or empty savetitle and the auto-child's parent comes out wrong.

     Optional `after-create`: the NAME of a procedure (a global macro, so it is in
     scope wherever the save runs) invoked — also nested inside the createtiddler —
     after apply-auto-children, with <<createTiddler-title>> in scope. Lets a caller
     react to the FRESH new title without hitting the async-savetitle staleness. It
     MUST be a `$variable` transclude, not a `$tiddler` one: core action-createtiddler
     calls `refreshChildren()` with no argument, and a title-based transclude child
     then dereferences `undefined[transcludeTitle]` and throws (a `$variable`
     transclude short-circuits before that — which is why apply-auto-children is
     also `$variable`). Used by rimir/dashboard to drop a tile for the new instance
     into the same group; empty = no-op, so every existing caller is unaffected. -->
<$action-createtiddler $basetitle={{{ [function[kind.create-title],<kind-tid>,<draft-tid>] }}} $template=<<draft-tid>> $savetitle=<<savetitle>> kind.type=<<kind-type-key>>>
<$transclude $variable="kind.apply-auto-children" parent-tid=<<createTiddler-title>> type-tid=<<kind-tid>>/>
<$list filter="[<after-create>!is[blank]]" variable="_fac">
<$transclude $variable=<<after-create>>/>
</$list>
</$action-createtiddler>
\end

\procedure kind.apply-auto-children(parent-tid, type-tid)
<!-- Walks the parent type's `kind.auto-children` JSON array and creates each
     listed child instance with `parent: <<parent-tid>>` + per-entry field
     overrides + the child kind's own field defaults applied. The child's
     `kind.title-formula` evaluates against the draft (so it sees the pre-set
     parent + overrides). Called by every "save parent instance" path after
     the parent tiddler exists. Entries pointing at non-existent kinds are
     skipped silently. NOT recursive — auto-children of auto-children don't
     fire (the child create here uses $action-createtiddler directly, not a
     save-path that calls this procedure). Keeps shared state simple. -->
<$list filter="[function[kind.auto-children-indexes],<type-tid>]" variable="ac-idx">
<$let child-kind-key={{{ [function[kind.auto-child-kind-at],<type-tid>,<ac-idx>] }}}>
<$let
  child-type-tid={{{ [function[kind.locate-type],<child-kind-key>] }}}
  child-draft={{{ [[$:/state/rimir/kind/__auto-child-draft/]] +[addsuffix<parent-tid>] +[addsuffix[/]] +[addsuffix<ac-idx>] }}}
>
<$list filter="[<child-type-tid>!is[blank]]">
<$transclude $variable="kind.apply-defaults-to" type-tid=<<child-type-tid>> target-tid=<<child-draft>>/>
<$action-setfield $tiddler=<<child-draft>> parent=<<parent-tid>>/>
<$list filter="[function[kind.auto-child-fields-at],<type-tid>,<ac-idx>]" variable="fk">
<$action-setfield $tiddler=<<child-draft>> $field=<<fk>> $value={{{ [function[kind.auto-child-field-value-at],<type-tid>,<ac-idx>,<fk>] }}}/>
</$list>
<$action-createtiddler $basetitle={{{ [function[kind.create-title],<child-type-tid>,<child-draft>] }}} $template=<<child-draft>> kind.type=<<child-kind-key>>/>
<$action-deletetiddler $tiddler=<<child-draft>>/>
</$list>
</$let>
</$let>
</$list>
\end

\procedure kind.force-apply-defaults(type-tid, target-tid)
<!-- Like kind.apply-defaults-to but unconditional: writes every defaulted
     field regardless of existing state, falling back to existing value if
     the formula returns blank. Used by the Reset row. Same fire-time
     evaluation pattern via $value={{{…}}} so a Reset clicked after partial
     dependency fills resolves the cascade correctly. Stamps `kind.type` so
     the freshly-reset draft is recognised by the side-preview. -->
<$action-setfield $tiddler=<<target-tid>> kind.type={{{ [<type-tid>get[kind.type]] }}}/>
<$list filter="[function[kind.field-keys],<type-tid>]" variable="field-key">
<$list filter="[function[kind.field-default],<type-tid>,<field-key>!is[blank]] +[first[]]" variable="_">
<$action-setfield $tiddler=<<target-tid>> $field=<<field-key>> $value={{{ [function[kind.compute-default],<type-tid>,<field-key>,<target-tid>!is[blank]] ~[<target-tid>get<field-key>] +[first[]] }}}/>
</$list>
</$list>
\end

\procedure kind.instance-content(n)
<!-- Renders instance <<n>>'s editable own-content: the `text` body and/or its
     sq/streams structure, with empty-state init affordances. Streams render via
     sq/streams' nodes-list-template, whose in-place double-click editing is pure
     $action-*/$eventcatcher (no navigator messages), so it works wherever this
     is mounted (story-river ViewTemplate, body-mounted cp side-preview, etc.).
     For an empty instance: Streams' OWN "+" button (rendered by the template
     when installed) starts a stream; the "✎ Text" button starts a text body by
     setting $:/state/rimir/kind/notes/text-edit. Shared by notes.tid + the cockpit detail pane. -->
<%if [function[kind.note-text-editing],<n>] %>
<div class="kind-notes-textedit">
<$edit-text tiddler=<<n>> field="text" tag="textarea" class="kind-notes-textarea" placeholder="Write text…"/>
<div class="kind-notes-textedit-foot">
<$button class="kind-pill" actions="""<$action-deletetiddler $tiddler="$:/state/rimir/kind/notes/text-edit"/>""">✓ Done</$button>
</div>
</div>
<%else%>
<%if [function[kind.note-has-text],<n>] %>
<div class="kind-notes-text"><$transclude $tiddler=<<n>> $mode="block"/></div>
<%endif%>
<%if [function[kind.streams-on]] :filter[function[kind.note-stream-slot],<n>] %>
<div class="kind-notes-stream"><$tiddler tiddler=<<n>>>{{||$:/plugins/sq/streams/nodes-list-template}}</$tiddler></div>
<%endif%>
<%if [function[kind.note-empty],<n>] %>
<div class="kind-notes-init">
<span class="kind-notes-init-label">Empty — start as <%if [function[kind.streams-on]] %>a stream (＋ above) or <%endif%>text:</span>
<$button class="kind-pill" actions="""<$action-setfield $tiddler="$:/state/rimir/kind/notes/text-edit" text=<<n>>/>""">✎ Text</$button>
</div>
<%endif%>
<%endif%>
\end

<!-- Spawns: `kind.spawns` on a type lists what its instances create, as
     `<kind>` or `<kind>:<field>` entries (field = the new instance's ref back
     to the host, default `parent`), e.g. `conversation` on jour-fixe. Each
     entry is a ＋ button in the host's field bar (stream-view) that opens the
     create form with the link set and the host's fields copied
     (kind.gm-create-linked copy=yes). -->
\function kind.spawn-entries(type-tid) [<type-tid>get[kind.spawns]enlist-input[]]
\function kind.spawn-kind(entry) [<entry>split[:]first[]]
\function kind.spawn-field(entry) [<entry>split[:]nth[2]!is[blank]] ~[[parent]]
\function kind.inst-type(inst) [<inst>get[kind.type]] :map[function[kind.locate-type],<currentTiddler>]
\function kind.inst-values(inst, field-key) [function[kind.inst-type],<inst>] :filter[function[kind.field-cardinality],<currentTiddler>,<field-key>match[multi]] :map:flat[<inst>get<field-key>enlist-input[]] ~[<inst>get<field-key>!is[blank]]
\function kind.spawn-copy-keys(type-tid, src, link-key) [function[kind.field-keys],<type-tid>] -[<link-key>] :filter[function[kind.is-computed-typed],<type-tid>,<currentTiddler>count[]match[0]] :filter[function[kind.field-default],<type-tid>,<currentTiddler>count[]match[0]] :filter[<src>get<currentTiddler>!is[blank]]
\function kind.ref-accepts(type-tid, field-key, inst) [<inst>has[kind.type]!has[kind.fields]] :filter[function[kind.ref-types],<type-tid>,<field-key>count[]match[0]] ~[function[kind.member-accepted],<type-tid>,<field-key>,<inst>] +[then[yes]]
\function kind.ref-link-one(type-tid, field-key, value) [function[kind.ref-accepts],<type-tid>,<field-key>,<value>then<value>] ~[function[kind.group-members-for],<type-tid>,<field-key>,<value>]
\function kind.spawn-ref-values(type-tid, field-key, src) [function[kind.inst-values],<src>,<field-key>] :map:flat[function[kind.ref-link-one],<type-tid>,<field-key>,<currentTiddler>] +[unique[]]
\function kind.spawn-ref-string(type-tid, field-key, src) [function[kind.field-cardinality],<type-tid>,<field-key>match[multi]] :map[function[kind.spawn-ref-values],<type-tid>,<field-key>,<src>format:titlelist[]join[ ]] ~[function[kind.spawn-ref-values],<type-tid>,<field-key>,<src>first[]]

\procedure kind.spawn-buttons(host, host-type)
<!-- ＋ <Kind> buttons for the host's kind.spawns entries -->
<$list filter="[function[kind.spawn-entries],<host-type>]" variable="sp">
<$let sp-tid={{{ [function[kind.spawn-kind],<sp>] :map[function[kind.locate-type],<currentTiddler>] }}} sp-field={{{ [function[kind.spawn-field],<sp>] }}}>
<%if [<sp-tid>!is[blank]] %>
<$let sp-cap={{{ [<sp-tid>get[kind.caption]!is[blank]] ~[<sp-tid>get[kind.type]] }}}>
<$button class="tc-btn-invisible kind-spawn-btn" tooltip={{{ [<sp-cap>addprefix[New ]addsuffix[ from this, prefilled]] }}}>
<$transclude $variable="kind.gm-create-linked" type-tid=<<sp-tid>> host-tid=<<host>> field-key=<<sp-field>> dir="in" copy="yes"/>
<$text text={{{ [<sp-cap>addprefix[＋ ]] }}}/>
</$button>
</$let>
<%endif%>
</$let>
</$list>
\end

<!-- Focus (kind.focus: yes on the type): the story becomes the host followed
     by the tiddlers its focus rules find. The rules live in
     $:/config/rimir/kind/focus/<kind-key>, one filter per line (`#` lines are
     comments), with <host> = the focused instance; without that tiddler the
     shipped default applies ($:/plugins/rimir/kind/focus/default-rules: the
     tiddlers whose `parent` is the host). Each line is its own filter, so a
     :filter in one rule cannot narrow another; like a top-level filter a rule
     starts from all (non-shadow) tiddlers. Results are grouped by rule in
     line order, latest modified first within a rule; a tiddler found by an
     earlier rule is not repeated. The host and the rows of its own stream
     (stream-list) are left out; the host shows them. Computed on click only.
     add=yes (Shift-click) keeps the story: the found tiddlers are moved or
     opened right after the host, nothing is closed. -->
\function kind.focus-on(type-tid) [<type-tid>get[kind.focus]match[yes]]
\function kind.focus-parent(host) [all[tiddlers]field:parent<host>]
\function kind.focus-rules-tid(host) [<host>get[kind.type]addprefix[$:/config/rimir/kind/focus/]!is[missing]] ~[[$:/plugins/rimir/kind/focus/default-rules]]
\function kind.focus-rules(host) [function[kind.focus-rules-tid],<host>get[text]splitregexp[\n]trim[]!is[blank]!prefix[#]]
\function kind.focus-children(host) [function[kind.focus-rules],<host>] :map:flat[all[tiddlers]subfilter<currentTiddler>!is[draft]!sort[modified]] -[<host>] -[<host>get[stream-list]enlist-input[]] +[unique[]]

\procedure kind.focus-actions(host, add)
<%if [<add>!match[yes]] %>
<$action-listops $tiddler="$:/StoryList" $field="list" $filter="[<host>] [function[kind.focus-children],<host>]"/>
<%endif%>
<%if [<add>match[yes]] %>
<!-- Two steps: take the found tiddlers out, then put them back after the host -->
<$action-listops $tiddler="$:/StoryList" $field="list" $subfilter="-[function[kind.focus-children],<host>]"/>
<$action-listops $tiddler="$:/StoryList" $field="list" $filter="[list[$:/StoryList]allbefore<host>] [<host>] [function[kind.focus-children],<host>] [list[$:/StoryList]allafter<host>]"/>
<%endif%>
<$action-navigate $to=<<host>>/>
\end

\procedure kind.link-group(type-tid, target-tid, field-key, group)
<!-- Appends the members of <group> that <field-key> accepts (not the group); existing values keep their order -->
<$action-listops $tiddler=<<target-tid>> $field=<<field-key>> $filter="[<target-tid>get<field-key>enlist-input[]] =[function[kind.group-members-for],<type-tid>,<field-key>,<group>] +[unique[]]"/>
\end

\procedure kind.cockpit-toggle(host)
<!-- ▸/▾ Connections button for the generic cockpit of <host> -->
<$let open-state={{{ [function[kind.cockpit-open-state],<host>] }}}>
<%if [function[kind.cockpit-open],<host>] %>
<$button class="tc-btn-invisible kcp-toggle kcp-toggle-open" tooltip="Hide connections">
<$action-deletetiddler $tiddler=<<open-state>>/>
▾ Connections
</$button>
<%else%>
<$button class="tc-btn-invisible kcp-toggle" tooltip="Show incoming and outgoing connections" set=<<open-state>> setTo="yes">
▸ Connections
</$button>
<%endif%>
</$let>
\end

\procedure kind.iview-click-toggle()
<!-- the global open/split mode toggle pills (one filter-group) -->
<div class="kpv-filter-group">
<span class="kpv-filter-label">Click</span>
<$list filter="open split" variable="cm">
<$button class={{{ [function[kind.iview-click-mode]match<cm>then[kind-pill kind-pill-on]] ~[[kind-pill]] }}} tooltip="how clicking an item behaves">
<$action-setfield $tiddler="$:/state/rimir/kind/iview/click-mode" text=<<cm>>/>
<%if [<cm>match[open]] %>↗ open<%else%>⇆ split<%endif%>
</$button>
</$list>
</div>
\end

\procedure kind.iview-link(t, host)
<!-- a clickable target caption: in open mode a normal link; in split mode a
     button that pins <<t>> into this host's detail pane. -->
<$let cap-text={{{ [<t>get[caption]!is[blank]] ~[<t>] }}}>
<%if [function[kind.iview-click-mode]match[split]] %>
<$button class="kpv-row-link tc-btn-invisible">
<$action-setfield $tiddler={{{ [function[kind.iview-sel-state],<host>] }}} text=<<t>>/>
<$text text=<<cap-text>>/>
</$button>
<%else%>
<$link to=<<t>>><$text text=<<cap-text>>/></$link>
<%endif%>
</$let>
\end

\procedure kind.iview-detail(host)
<!-- right-hand detail pane for the host's currently-selected item: the kind
     read-only field card + its editable text/streams content, plus open/close. -->
<$let selected={{{ [function[kind.iview-selected],<host>] }}} sel-state={{{ [function[kind.iview-sel-state],<host>] }}}>
<div class="kpv-split-detail">
<div class="kpv-detail-head">
<$link to=<<selected>> class="kpv-detail-open" tooltip="open in story river">↗ open</$link>
<$button class="kpv-detail-close tc-btn-invisible" tooltip="close detail">
<$action-deletetiddler $tiddler=<<sel-state>>/>
✕
</$button>
</div>
<div class="kpv-detail-body">
<$tiddler tiddler=<<selected>>>
<$let target-tid=<<selected>>>
<$transclude $tiddler="$:/plugins/rimir/kind/view"/>
</$let>
<div class="kind-notes-item kpv-detail-content">
<$transclude $variable="kind.instance-content" n=<<selected>>/>
</div>
</$tiddler>
</div>
</div>
</$let>
\end
